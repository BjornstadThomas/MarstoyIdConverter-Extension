{
  "manifest_version": 2,
  "name": "Marstoy Id Converter",
  "version": "2.1.1",
  "description": "Updates product titles on Marstoy by checking against Rebrickable.",
  "permissions": [
    "activeTab",
    "storage",
    "*://*.marstoy.com/*",
    "*://*.rebrickable.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.marstoy.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_popup": "popup.html"
  },
  "applications": {
    "gecko": {
      "id": "marstoy-id-converter@extension",
      "strict_min_version": "68.0"
    }
  }
}